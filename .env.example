# .env.example
# ------------------------------------------------------------------
# IMPORTANT: DO NOT PUT REAL API KEYS HERE! 
# This file is safe to commit to version control. 
# Duplicate this file, rename it to '.env', and insert your real keys.
# The actual '.env' file is strictly blocked from Git via .gitignore.
# ------------------------------------------------------------------

# ── LLM & Embeddings (Google Gemini) ──
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_EMBED_MODEL=models/gemini-embedding-2
GEMINI_EMBED_DIM=768

# ── Pinecone (Vector Store) ──
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=tfm-vault
PINECONE_NAMESPACE=vault-pdfs

# ── Neo4j (Knowledge Graph) ──
NEO4J_URI=neo4j+s://your-database.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ── Supabase (Structured Data PostgreSQL) ──
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# ── Google Drive (Remote Documents) ──
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key
GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_FOLDER_ID=your_restricted_folder_id_here

# ── LangSmith Tracing (Observability) ──
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=tfm-multi-tool-agent

# ── External Data APIs ──
# AEMET OpenData API (Spanish Meteorological Agency)
AEMET_API_KEY=your_aemet_api_key_here

# Hugging Face Inference API (For fallback LLMs)
HF_TOKEN=your_huggingface_read_token_here

# GitHub Token (For git operations)
GITHUB_TOKEN=your_github_pat_token_here
